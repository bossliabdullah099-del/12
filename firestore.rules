rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if false;
    }

    // --- Generated Images Collection ---
    match /images/{imageId} {
      allow read: if true;
      allow create: if isSignedIn() 
        ? request.resource.data.userId == request.auth.uid 
        : request.resource.data.userId is string;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
    }

    // --- Chat Conversations ---
    match /conversations/{conversationId} {
      allow read: if true;
      allow create: if isSignedIn() 
        ? request.resource.data.userId == request.auth.uid 
        : request.resource.data.userId is string;
      allow update: if (isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin')) || !isSignedIn();
      allow delete: if (isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin')) || !isSignedIn();
      
      match /messages/{messageId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // --- Test Connection Path ---
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
